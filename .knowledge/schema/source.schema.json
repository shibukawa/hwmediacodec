{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "adapter",
    "location"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^source:[a-z0-9][a-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "enum": [
        "catalog",
        "document",
        "lsp",
        "jsonl",
        "go-module"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string"
        },
        "path_env": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "selection": {
          "enum": [
            "filesystem",
            "git"
          ]
        },
        "include_untracked": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "include_nested_repositories": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "root"
          ]
        },
        {
          "required": [
            "path_env"
          ]
        }
      ]
    },
    "watch": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^source:"
      }
    },
    "coverage": {
      "type": "object"
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "language_id": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "definitions",
              "references",
              "hover",
              "calls"
            ]
          }
        },
        "timeout_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 300
        },
        "max_symbols": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        ]
      }
    },
    "lifecycle": {
      "enum": [
        "proposed",
        "accepted",
        "active",
        "superseded",
        "retired"
      ]
    },
    "derived_from": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "upstream": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "product": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        },
        "refresh_request": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "id": {
            "const": "source:authored"
          }
        }
      },
      "then": {
        "properties": {
          "adapter": {
            "const": "catalog"
          },
          "location": {
            "required": [
              "root"
            ],
            "properties": {
              "root": {
                "const": ".knowledge"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "adapter": {
            "const": "lsp"
          }
        }
      },
      "then": {
        "required": [
          "collector"
        ],
        "properties": {
          "location": {
            "required": [
              "include"
            ],
            "properties": {
              "include": {
                "minItems": 1
              }
            }
          },
          "collector": {
            "required": [
              "command",
              "language_id"
            ]
          }
        }
      }
    }
  ]
}
